# Copy to .env and fill in. Loaded automatically by `eufy-snap` from the current directory.
# Use the DEDICATED tool account, not your main Eufy account.

EUFY_EMAIL=tool-account@example.com
EUFY_PASSWORD=change-me
# Two-letter country of the Eufy account (routes to the right region shard).
EUFY_COUNTRY=US

# Optional: where config, session, photos and logs live (default ~/.eufy-snap). For the daemon,
# copy this file to $EUFY_SNAP_HOME/env (chmod 600) — it is read from there too.
# EUFY_SNAP_HOME=/Users/eufysnap/.eufy-snap

# Optional: explicit ffmpeg binary (default: resolved on PATH)
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Optional: SDK diagnostics — debug | info | warn | error (default: warn)
# EUFY_LOG_LEVEL=info

# Optional: Telegram delivery (omit both and nothing is sent). Names are configurable in config.yaml.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
